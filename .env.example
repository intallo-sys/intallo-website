# Database (Prisma Postgres / PostgreSQL / Neon / Supabase)
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"
POSTGRES_URL="postgres://user:password@host:5432/postgres?sslmode=require"
PRISMA_DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Email Notification (Resend)
RESEND_API_KEY="re_your_api_key_here"
RESEND_EMAIL_DOMAIN="intallo.in"
CONTACT_FROM_EMAIL="notifications@intallo.in"
CONTACT_RECIPIENT_EMAIL="contact@intallo.in"

# Security & Rate Limiting
IP_HASH_SECRET="your-secure-random-secret-key"
